 #define NUM_SAMPLES 8
 #define FRAMEBUFFER_HEIGHT 1024
+#define FRAMEBUFFER_MAX_HEIGHT 2048
+
+//Games may draw below the 1024th line of a buffer, and use what they drew there
+//as a texture (ex.: Midnight Club's video player). Make buffers as tall as the
+//GS memory after their start allows, within what CGsCachedArea can track.
+static uint32 GetFramebufferHeight(uint32 basePtr, uint32 width, uint32 psm)
+{
+	auto pageSize = CGsPixelFormats::GetPsmPageSize(psm);
+	uint32 pagesPerLine = std::max<uint32>((width + pageSize.first - 1) / pageSize.first, 1);
+	uint32 pagesLeft = (basePtr < CGSHandler::RAMSIZE) ? ((CGSHandler::RAMSIZE - basePtr) / CGsPixelFormats::PAGESIZE) : 0;
+	pagesLeft = std::min<uint32>(pagesLeft, CGsCachedArea::MAX_DIRTYPAGES);
+	uint32 height = (pagesLeft / pagesPerLine) * pageSize.second;
+	return std::clamp<uint32>(height, FRAMEBUFFER_HEIGHT, FRAMEBUFFER_MAX_HEIGHT);
+}
 
