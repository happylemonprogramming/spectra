+//A framebuffer with the same width and format, inside which bufPtr starts on a page
+//boundary; offsetX and offsetY say where, in pixels.
+CGSH_OpenGL::FramebufferPtr CGSH_OpenGL::FindContainingFramebuffer(uint32 bufPtr, uint32 bufWidth, uint32 psm, uint32& offsetX, uint32& offsetY) const
+{
+	for(const auto& candidateFramebuffer : m_framebuffers)
+	{
+		if(candidateFramebuffer->m_basePtr > bufPtr) continue;
+		if(candidateFramebuffer->m_width != bufWidth) continue;
+		if(GetFramebufferBitDepth(candidateFramebuffer->m_psm) != GetFramebufferBitDepth(psm)) continue;
+
+		uint32 framebufferOffset = bufPtr - candidateFramebuffer->m_basePtr;
+		if((framebufferOffset & (CGsPixelFormats::PAGESIZE - 1)) != 0) continue;
+
+		auto pageSize = CGsPixelFormats::GetPsmPageSize(candidateFramebuffer->m_psm);
+		uint32 pageCountX = candidateFramebuffer->m_width / pageSize.first;
+		if(pageCountX == 0) continue;
+		uint32 pageIndex = framebufferOffset / CGsPixelFormats::PAGESIZE;
+		uint32 x = (pageIndex % pageCountX) * pageSize.first;
+		uint32 y = (pageIndex / pageCountX) * pageSize.second;
+		if(y >= candidateFramebuffer->m_height) continue;
+
+		offsetX = x;
+		offsetY = y;
+		return candidateFramebuffer;
+	}
+	return FramebufferPtr();
+}
